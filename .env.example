# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Get this from MongoDB Atlas → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority

# MongoDB database name
MONGODB_DB_NAME=labdrop

# Frontend origin (used for CORS in production)
# In production, set this to your Vercel deployment URL, e.g. https://labdrop.vercel.app
APP_ORIGIN=http://localhost:5173

# Rate limiting (requests per window)
RATE_LIMIT_CREATE_MAX=10
RATE_LIMIT_CREATE_WINDOW_MS=900000
RATE_LIMIT_RETRIEVE_MAX=20
RATE_LIMIT_RETRIEVE_WINDOW_MS=900000
